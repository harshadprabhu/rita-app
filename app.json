{
  "expo": {
    "name": "SARWAM",
    "slug": "rita-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "scheme": "rita",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#EDE8DC"
    },
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1",
      "bundleIdentifier": "com.indriyajewellery.rita",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to attach photos to SARWAM tickets",
        "NSPhotoLibraryUsageDescription": "Used to attach photos and videos from gallery to SARWAM tickets"
      }
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#1A2D5C"
      },
      "googleServicesFile": "./google-services.json",
      "package": "com.indriyajewellery.rita",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "SARWAM",
      "shortName": "SARWAM",
      "themeColor": "#1A2D5C",
      "backgroundColor": "#F4F6F9",
      "display": "standalone"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/logo.png",
          "color": "#1A2D5C"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SARWAM accesses your photos and videos to attach them to tickets.",
          "cameraPermission": "SARWAM accesses your camera to attach photos to tickets."
        }
      ],
      "expo-document-picker",
      "expo-localization",
      "expo-web-browser",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "SARWAM uses the microphone to let you dictate a ticket description.",
          "speechRecognitionPermission": "SARWAM uses speech recognition to convert your dictation into text."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "083fc174-cf77-4763-85cf-9a33b0297495"
      }
    }
  }
}
